# Kopiera till .env och ändra om du vill. .env committas aldrig.
# SL Transport kräver ingen API nyckel, så det här är inställningar, inte hemligheter.

# Hållplatsens id. 9192 är Slussen, 9001 T-Centralen, 9117 Odenplan.
SITE_ID=9192
SITE_NAME=Slussen

# METRO, BUS, TRAIN, TRAM eller SHIP. Lämna tomt för alla färdmedel.
TRANSPORT_MODE=METRO

# Hur långt fram i tiden vi hämtar avgångar, i minuter.
FORECAST_MINUTES=60

# Vart resultatet skrivs. Sidan i docs/ läser den här filen.
OUTPUT_PATH=docs/data/avgangar.json
